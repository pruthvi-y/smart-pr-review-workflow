AWS_REGION=us-east-1
AWS_PROFILE=your-profile
BEDROCK_MODEL_ID=your-bedrock-model-or-inference-profile-id
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
DEMO_FORCE_FIRST_REVISION=false

# GitHub source/action
GITHUB_ENABLED=false
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-github-repo
GITHUB_PR_NUMBER=1
GITHUB_TOKEN=your-github-token
GITHUB_API_URL=https://api.github.com
GITHUB_MAX_FILES=50

# Stage 8: choose how LangGraph reaches GitHub
# mcp = default Stage 8 path; rest = Stage 7 compatibility path
GITHUB_INTEGRATION=mcp

# Keep false until you are ready to post a real comment.
GITHUB_POST_REVIEW_COMMENT=false

# MCP local server logging (stderr only)
MCP_LOG_LEVEL=WARNING
